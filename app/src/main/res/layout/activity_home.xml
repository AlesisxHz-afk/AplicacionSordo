<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".HomeActivity">

    <!-- Main Screen Content -->
    <LinearLayout
        android:id="@+id/mainContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Navigation Toolbar with Hamburger Menu (3 lines) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/primary"
            app:navigationIcon="@drawable/ic_menu"
            app:navigationIconTint="@color/white"
            app:title="Probar / Traducir Señas"
            app:titleTextColor="@color/white" />

        <!-- Container for Module Switcher -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- ========================================== -->
            <!-- MODULE 1: PROBAR / TRADUCIR SEÑAS (LIVE)   -->
            <!-- ========================================== -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/layoutProbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="visible">

                <!-- Camera Live Preview -->
                <androidx.camera.view.PreviewView
                    android:id="@+id/previewViewProbar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Camera Switch Floating Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSwitchCamera"
                    style="@style/Widget.Material3.Button.IconButton.Filled"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_margin="12dp"
                    app:icon="@drawable/ic_camera_switch"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Hand Detection Toggle Switch Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleHandSim"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_margin="12dp"
                    android:text="🖐️ Probar Detección Mano"
                    android:textSize="11sp"
                    app:cornerRadius="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <!-- Permission Denied Layout -->
                <LinearLayout
                    android:id="@+id/layoutPermissionDenied"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="24dp"
                    android:background="@color/card_background"
                    android:elevation="6dp"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/camera_permission_required"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnGrantPermission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Conceder Permiso" />
                </LinearLayout>

                <!-- Bottom Floating Container for Live Result & Sentence Builder -->
                <LinearLayout
                    android:id="@+id/bottomContainerProbar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <!-- Translation Live Result Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="#CC0F172A"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:id="@+id/tvHandStatusBadge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🟢 SEÑA DETECTADA"
                                    android:textColor="#4ADE80"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvConfidence"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:text="Confianza: 95%"
                                    android:textColor="#94A3B8"
                                    android:textSize="11sp" />
                            </RelativeLayout>

                            <TextView
                                android:id="@+id/tvTranslatedText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="center"
                                android:text="Realiza una seña frente a la cámara..."
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Sentence Builder Card (Formar Frase / Oración) -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        app:cardBackgroundColor="#F8FAFC"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="6dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="10dp">

                            <!-- Sentence Header with Text-To-Speech Button -->
                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:text="📝 ORACIÓN CONSTRUIDA"
                                    android:textColor="@color/primary"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnSpeakSentence"
                                    style="@style/Widget.Material3.Button.IconButton"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:layout_alignParentEnd="true"
                                    app:icon="@drawable/ic_volume"
                                    app:iconSize="18dp"
                                    app:iconTint="@color/primary" />
                            </RelativeLayout>

                            <!-- Sentence Output Display Text -->
                            <TextView
                                android:id="@+id/tvSentence"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:layout_marginBottom="6dp"
                                android:background="#E2E8F0"
                                android:padding="8dp"
                                android:text="Presiona '+' para ir formando una frase con las señas..."
                                android:textColor="@color/text_primary"
                                android:textSize="13sp"
                                android:textStyle="italic" />

                            <!-- Sentence Action Control Buttons -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnAddWord"
                                    android:layout_width="0dp"
                                    android:layout_height="38dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="3dp"
                                    android:backgroundTint="@color/primary"
                                    android:text="+ Agregar"
                                    android:textSize="11sp"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnBackspace"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="38dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="3dp"
                                    android:layout_marginEnd="3dp"
                                    android:text="⌫ Borrar"
                                    android:textSize="11sp"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClearSentence"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="38dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="3dp"
                                    android:text="🗑️ Limpiar"
                                    android:textColor="@color/error"
                                    android:textSize="11sp"
                                    app:cornerRadius="8dp"
                                    app:strokeColor="@color/error" />
                            </LinearLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- ========================================== -->
            <!-- MODULE 2: ENTRENAR MODELO (CAPTURAR SEÑAS) -->
            <!-- ========================================== -->
            <ScrollView
                android:id="@+id/layoutEntrenar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Training Controls Header Card -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="@color/card_background"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎓 Entrenar Nueva Seña"
                                android:textColor="@color/primary"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Escribe el nombre de la seña (Tag) y realiza el gesto frente a la cámara:"
                                android:textColor="@color/text_secondary"
                                android:textSize="12sp" />

                            <!-- Tag Input -->
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/tilTag"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:hint="Tag de la seña (Ej: Hola, Gracias, Letra A)">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etTag"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:inputType="textCapWords"
                                    android:maxLines="1" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <!-- Buttons Row -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCapturarMuestra"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:layout_marginEnd="4dp"
                                    android:backgroundTint="@color/primary"
                                    android:text="📷 Capturar Muestra"
                                    android:textSize="11sp"
                                    app:cornerRadius="8dp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnGuardarModelo"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="0dp"
                                    android:layout_height="44dp"
                                    android:layout_weight="1"
                                    android:layout_marginStart="4dp"
                                    android:text="💾 Guardar Modelo"
                                    android:textSize="11sp"
                                    app:cornerRadius="8dp" />
                            </LinearLayout>

                            <!-- Delete All Model Button (Empezar desde 0) -->
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnBorrarModelo"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="40dp"
                                android:layout_marginTop="6dp"
                                android:text="🗑️ Borrar Todas las Señas (Comenzar desde 0)"
                                android:textColor="@color/error"
                                android:textSize="11sp"
                                app:cornerRadius="8dp"
                                app:strokeColor="@color/error" />

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Camera Training Preview Container -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="220dp"
                        android:layout_marginTop="10dp"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="2dp">

                        <androidx.camera.view.PreviewView
                            android:id="@+id/previewViewEntrenar"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent" />

                    </androidx.cardview.widget.CardView>

                    <!-- Saved Dataset Summary Status -->
                    <androidx.cardview.widget.CardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="12dp"
                        app:cardBackgroundColor="#F1F5F9"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvModelStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:padding="10dp"
                            android:text="Señas en el modelo: Cargando..."
                            android:textColor="@color/text_primary"
                            android:textSize="12sp" />
                    </androidx.cardview.widget.CardView>

                </LinearLayout>
            </ScrollView>

        </FrameLayout>
    </LinearLayout>

    <!-- Side Navigation Menu (Drawer View) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>
